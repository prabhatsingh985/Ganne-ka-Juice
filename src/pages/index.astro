      // =========================================================
      // YOUTUBE BACKGROUND AUDIO SYSTEM
      // Supports:
      // ▶️ Play / Resume (continues from exact paused timestamp)
      // ⏸️ Pause (temporarily halts, preserving position)
      // ⏹️ Stop (completely stops and resets position to 0:00)
      // 🔄 Switch track (cycles tracks)
      // 🔊 Mute / Unmute
      // =========================================================
      const YT_TRACKS = [
        { id: 'zrzAbBTkFr8', title: 'Ganne Ka Juice' },
        { id: 'h6fq7sbxwBg', title: 'Tapri Rhythm' },
      ];
      let currentTrackIdx = 0;
      let ytPlayer: any = null;
      let isYtReady = false;
      let isAudioPlaying = false;

      type PlaybackState = 'playing' | 'paused' | 'stopped';
      let playbackState: PlaybackState = 'playing';

      function updateMusicUI() {
        const track = YT_TRACKS[currentTrackIdx];
        const isPlaying = playbackState === 'playing' && isAudioPlaying;

        // Play/Pause icon sync
        if (menuPlayIcon) menuPlayIcon.textContent = isPlaying ? '⏸️' : '▶️';
        if (jbPlayIcon) jbPlayIcon.textContent = isPlaying ? '⏸️' : '▶️';

        // Track title sync
        if (lofiText) lofiText.textContent = track.title;
        if (jbTrackName) jbTrackName.textContent = track.title;

        // Disc rotation sync
        if (jbDiscIcon) {
          if (isPlaying) {
            jbDiscIcon.classList.add('animate-spin');
