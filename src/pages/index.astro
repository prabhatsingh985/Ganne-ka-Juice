      function attachGlobalUnlockListeners() {
        unlockEvents.forEach((evt) => {
          window.addEventListener(evt, handleUserInteractionUnlock, { capture: true, passive: true });
          document.addEventListener(evt, handleUserInteractionUnlock, { capture: true, passive: true });
        });
      }

      function detachGlobalUnlockListeners() {
        unlockEvents.forEach((evt) => {
          window.removeEventListener(evt, handleUserInteractionUnlock, { capture: true } as any);
          document.removeEventListener(evt, handleUserInteractionUnlock, { capture: true } as any);
        });
