          updateMenuUI();
        });
      });

      unlockShagunBtn?.addEventListener('click', () => {
        isKesarUnlocked = true;
        selectedFlavor = 'kesar';
        shagunModal?.classList.add('hidden');
        if (kesarIcon) kesarIcon.textContent = '👑';
        if (kesarDesc) kesarDesc.textContent = 'Unlocked Shahi Blend';
