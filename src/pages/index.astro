    <!-- ========================================================= -->
    <!-- CHAI BAAR EXACT MULTI-SENSOR GYROSCOPE TRACKER & FLUID ENGINE -->
    <!-- ========================================================= -->
    <script>
      import { soundEngine } from '../scripts/audio';

      // Flavors definition
      type Flavor = 'saada' | 'nimbu' | 'kesar';
      let selectedFlavor: Flavor = 'saada';
      let isKesarUnlocked = false;
      let isFinished = false;

      // Views & Elements
      const viewMenu = document.getElementById('view-menu');
      const viewDrinking = document.getElementById('view-drinking');
      const backToMenuBtn = document.getElementById('back-to-menu-btn');
      const openGlassBtn = document.getElementById('open-glass-btn');
      const sipTapCard = document.getElementById('sip-tap-card');
      const sipFlavorIcon = document.getElementById('sip-flavor-icon');
      const sipCardTitle = document.getElementById('sip-card-title');
      const sipCardDesc = document.getElementById('sip-card-desc');
      const sipCountBadge = document.getElementById('sip-count-badge');
      const audioToggleBtn = document.getElementById('audio-toggle-btn');
      const soundIcon = document.getElementById('sound-icon');
      const resetBtn = document.getElementById('reset-btn');
      const finishReplayBtn = document.getElementById('finish-replay-btn');
      const pourStreamLeft = document.getElementById('pour-stream');
      const pourStreamRight = document.getElementById('pour-stream-right');

      // Jukebox Elements
      const jukeboxPill = document.getElementById('jukebox-pill');
      const jbPlayBtn = document.getElementById('jb-play-btn');

      // Menu Cards
      const tapriPills = document.querySelectorAll('.tapri-pill');
      const kesarIcon = document.getElementById('kesar-icon');
      const kesarDesc = document.getElementById('kesar-desc');
      const shagunModal = document.getElementById('shagun-modal');
      const unlockShagunBtn = document.getElementById('unlock-shagun-btn');

      // Preview glass elements
      const previewLiquid = document.getElementById('preview-liquid');
      const previewMint = document.getElementById('preview-mint');
      const previewKesar = document.getElementById('preview-kesar');

      // Audio Lo-Fi in menu
      const lofiToggleBtn = document.getElementById('lofi-toggle-btn');
      const lofiIcon = document.getElementById('lofi-icon');
      const lofiText = document.getElementById('lofi-text');

      function showToast(msg: string) {
        const toast = document.getElementById('app-toast');
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.remove('opacity-0', 'pointer-events-none');
        toast.classList.add('opacity-100');
        setTimeout(() => {
          toast.classList.remove('opacity-100');
          toast.classList.add('opacity-0', 'pointer-events-none');
        }, 2200);
      }

      function updateAudioUI(isPlaying: boolean) {
        if (lofiIcon) lofiIcon.textContent = isPlaying ? '⏸️' : '▶️';
        if (lofiText) lofiText.textContent = isPlaying ? 'Tapri Lo-Fi (Playing 🎵)' : 'Ganna Tapri – Later';
        if (jbPlayBtn) jbPlayBtn.textContent = isPlaying ? '⏸️' : '▶️';
        if (soundIcon) soundIcon.textContent = isPlaying ? '🔊' : '🔇';
      }

      lofiToggleBtn?.addEventListener('click', () => {
        const isPlaying = soundEngine.toggleLofi();
        updateAudioUI(isPlaying);
        showToast(isPlaying ? '🎵 Tapri Chill Lo-Fi Started' : 'Audio Paused');
      });

      audioToggleBtn?.addEventListener('click', () => {
        const isMuted = soundEngine.toggleMute();
        updateAudioUI(!isMuted);
      });

      jukeboxPill?.addEventListener('click', () => {
        const isPlaying = soundEngine.toggleLofi();
        updateAudioUI(isPlaying);
      });

      // Flavor selection in menu
      tapriPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const flavor = pill.getAttribute('data-flavor') as Flavor;
          if (flavor === 'kesar' && !isKesarUnlocked) {
