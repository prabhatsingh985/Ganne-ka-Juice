            jbDiscIcon.classList.remove('animate-spin');
          }
        }
      }

      function attemptStartAudio() {
        if (!ytPlayer || !isYtReady || playbackState !== 'playing') return;
        try {
          if (!soundEngine.getMuted()) {
            ytPlayer.unMute();
            ytPlayer.setVolume(35);
          }
          ytPlayer.playVideo();
        } catch (e) {
          console.warn('Playback start attempt:', e);
        }
      }

      function playOrResumeMusic() {
        playbackState = 'playing';
        if (ytPlayer && isYtReady) {
          try {
            if (ytPlayer.getPlayerState?.() === (window as any).YT?.PlayerState?.ENDED) {
              ytPlayer.seekTo(0, true);
            }
            if (!soundEngine.getMuted()) {
              ytPlayer.unMute();
              ytPlayer.setVolume(35);
            }
            ytPlayer.playVideo();
          } catch (e) {
            console.warn('Play error:', e);
          }
        }
        updateMusicUI();
        showToast(`▶️ Music Playing: ${YT_TRACKS[currentTrackIdx].title}`);
      }

      function pauseMusic() {
        playbackState = 'paused';
        isAudioPlaying = false;
        if (ytPlayer && isYtReady) {
          try {
            ytPlayer.pauseVideo(); // Freezes at exact current timestamp!
          } catch (e) {
            console.warn('Pause error:', e);
          }
        }
        updateMusicUI();
        showToast('⏸️ Music Paused');
      }

      function togglePlayPause() {
        if (playbackState === 'playing' && isAudioPlaying) {
          pauseMusic();
        } else {
          playOrResumeMusic();
        }
      }

      function stopMusic() {
        playbackState = 'stopped';
        isAudioPlaying = false;
        if (ytPlayer && isYtReady) {
          try {
            ytPlayer.seekTo(0, true); // Reset position to beginning!
            ytPlayer.pauseVideo();    // Halt playback!
          } catch (e) {
            console.warn('Stop error:', e);
          }
        }
        updateMusicUI();
        showToast('⏹️ Music Stopped (Reset to 0:00)');
      }

      function switchTrack() {
        currentTrackIdx = (currentTrackIdx + 1) % YT_TRACKS.length;
        const nextTrack = YT_TRACKS[currentTrackIdx];
        if (ytPlayer && isYtReady) {
          try {
            ytPlayer.loadVideoById({
              videoId: nextTrack.id,
              startSeconds: 0,
            });
            if (playbackState !== 'stopped') {
              if (!soundEngine.getMuted()) {
                ytPlayer.unMute();
                ytPlayer.setVolume(35);
                ytPlayer.playVideo();
              }
              playbackState = 'playing';
            } else {
              ytPlayer.pauseVideo();
