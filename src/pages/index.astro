      // Persistent Autoplay Unlock: Keeps listening until audio ACTUALLY starts playing!
      // Never detaches prematurely before YouTube API is ready.
      // Uses capture: true to catch the first tap/click even if a child element calls stopPropagation().
      const unlockEvents = ['pointerdown', 'touchstart', 'click', 'keydown'];
      const handleUserInteractionUnlock = () => {
        if (playbackState === 'playing' && !isAudioPlaying) {
          attemptStartAudio();
        }
