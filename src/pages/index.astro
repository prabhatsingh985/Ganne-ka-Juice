---
// Ganna Baar (गन्ने का रस) - Ultra-Minimalist Desi Tapri Web Toy
// Full viewport drinking glass with real-time 2D fluid wave & sloshing physics,
// true multi-point wave surface tension, inertia, and mouth-tilt sensor detection.
import '../styles/global.css';
---

<!doctype html>
<html lang="hi" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO & Metadata -->
    <title>गन्ने का रस — GANNA BAAR | The Online Ganna Break</title>
    <meta
      name="description"
      content="The Online Ganna Break ☀️ — Minimalist desi tapri web toy with real fluid physics. Tilt your phone to sip fresh sugarcane juice!"
    />
    <meta name="theme-color" content="#070e04" />

    <!-- Open Graph Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="गन्ने का रस — GANNA BAAR" />
    <meta
      property="og:description"
      content="The Online Ganna Break ☀️ — Real fluid physics. Phone ko tilt karo aur fresh ganne ka ras piyo!"
    />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="गन्ने का रस — GANNA BAAR" />
    <meta name="twitter:image" content="/og.png" />

    <!-- Google Fonts: Baloo 2 + Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800;900&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#070e04] text-zinc-100 flex flex-col justify-between items-center relative select-none overflow-x-hidden">
    <!-- Ambient Sugarcane Aura -->
    <div class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[380px] sm:w-[500px] h-[380px] sm:h-[500px] bg-gradient-to-tr from-lime-600/20 via-yellow-400/15 to-transparent rounded-full blur-3xl pointer-events-none -z-10"></div>

    <!-- Quick Toast Notification -->
    <div
      id="app-toast"
      class="fixed top-5 left-1/2 -translate-x-1/2 z-50 px-4 py-2 rounded-full bg-zinc-950 text-lime-300 font-display text-xs font-bold border border-lime-500/40 opacity-0 pointer-events-none transition-all duration-300 shadow-xl"
    >
      Link Copied! 🌾
    </div>

    <!-- ========================================================= -->
    <!-- REAL-TIME SENSOR-DEBUG PANEL (REQUIRED FOR VERIFICATION) -->
    <!-- ========================================================= -->
    <aside
      id="sensor-debug-panel"
      class="fixed top-2 left-2 right-2 sm:right-auto sm:left-4 sm:w-84 z-50 bg-[#091206]/95 border-2 border-lime-500/80 rounded-2xl p-3 text-xs font-mono shadow-2xl backdrop-blur-md select-text transition-all"
    >
      <div class="flex items-center justify-between border-b border-lime-500/30 pb-1.5 mb-2">
        <div class="flex items-center gap-1.5 font-bold text-lime-400">
          <span class="animate-pulse">📡</span>
          <span>SENSOR DEBUGGER</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span id="dbg-pulse-dot" class="w-2 h-2 rounded-full bg-zinc-600"></span>
          <button id="debug-toggle-btn" type="button" class="text-zinc-400 hover:text-white px-2 py-0.5 rounded bg-zinc-800 text-[10px] cursor-pointer">
            Hide
          </button>
        </div>
      </div>

      <div id="debug-body" class="space-y-1.5 text-zinc-300">
        <!-- Status Row -->
        <div class="flex justify-between items-center bg-black/50 px-2 py-1 rounded-lg">
          <span class="text-zinc-400 text-[11px]">Sensor Status:</span>
          <span id="dbg-status" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40">
            CHECKING...
          </span>
        </div>

        <div class="flex justify-between items-center text-[10px] px-1">
          <span class="text-zinc-400">Source API:</span>
          <span id="dbg-source" class="text-zinc-200 font-bold">none</span>
        </div>

        <!-- Raw Alpha / Beta / Gamma -->
        <div class="grid grid-cols-3 gap-1 text-center bg-black/60 p-1.5 rounded-lg border border-zinc-800">
          <div>
            <div class="text-[9px] text-zinc-500 uppercase">alpha</div>
            <div id="dbg-alpha" class="font-bold text-zinc-200 text-xs">--</div>
          </div>
          <div>
            <div class="text-[9px] text-zinc-500 uppercase">beta</div>
            <div id="dbg-beta" class="font-bold text-zinc-200 text-xs">--</div>
          </div>
          <div>
            <div class="text-[9px] text-zinc-500 uppercase">gamma</div>
            <div id="dbg-gamma" class="font-bold text-zinc-200 text-xs">--</div>
          </div>
        </div>

        <!-- Calculated Tilt X & Y -->
        <div class="grid grid-cols-2 gap-1.5 bg-black/60 p-1.5 rounded-lg border border-zinc-800">
          <div>
            <span class="text-[9px] text-zinc-400 block">Calc Tilt X (Roll):</span>
            <span id="dbg-tilt-x" class="text-sm font-bold text-lime-400">0.0°</span>
          </div>
          <div>
            <span class="text-[9px] text-zinc-400 block">Calc Tilt Y (Pitch):</span>
            <span id="dbg-tilt-y" class="text-sm font-bold text-amber-400">0.0°</span>
          </div>
        </div>

        <!-- Gravity X & Y -->
        <div class="grid grid-cols-2 gap-1.5 bg-black/60 p-1.5 rounded-lg border border-zinc-800">
          <div>
            <span class="text-[9px] text-zinc-400 block">Gravity X (m/s²):</span>
            <span id="dbg-grav-x" class="text-xs font-bold text-zinc-200">--</span>
          </div>
          <div>
            <span class="text-[9px] text-zinc-400 block">Gravity Y (m/s²):</span>
            <span id="dbg-grav-y" class="text-xs font-bold text-zinc-200">--</span>
          </div>
        </div>

        <!-- Visual Tilt Meter Bar -->
        <div class="bg-black/60 p-1.5 rounded-lg border border-zinc-800">
          <div class="flex justify-between text-[8px] text-zinc-500 mb-0.5">
            <span>◀ TILT LEFT 30°</span>
            <span>CENTER</span>
            <span>TILT RIGHT 30° ▶</span>
          </div>
          <div class="relative w-full h-2.5 bg-zinc-800 rounded-full overflow-hidden">
            <div class="absolute top-0 bottom-0 left-1/2 w-0.5 bg-zinc-500 -translate-x-1/2"></div>
            <div id="dbg-meter-bar" class="absolute top-0 bottom-0 w-3 bg-lime-400 rounded-full transition-all -translate-x-1/2" style="left: 50%;"></div>
          </div>
        </div>

        <!-- Upside-Down Drinking Angle & Hysteresis State -->
        <div class="bg-black/60 p-2 rounded-lg border border-zinc-800 space-y-1">
          <div class="flex justify-between items-center">
            <span class="text-[9px] text-zinc-400">Drinking State:</span>
            <span id="dbg-drink-state" class="px-2 py-0.5 rounded text-[10px] font-bold bg-zinc-800 text-zinc-400 border border-zinc-700">
              IDLE
            </span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-[9px] text-zinc-400">Upside-Down Angle:</span>
            <span id="dbg-drink-angle" class="text-xs font-bold text-amber-300">0.0°</span>
          </div>
          <div class="text-[8px] text-zinc-500 flex justify-between">
            <span>Start: ≥ 140° (Inverted)</span>
            <span>Stop: &lt; 125°</span>
          </div>
          <!-- Inversion Progress Meter (0° to 180°) -->
          <div class="relative w-full h-2 bg-zinc-800 rounded-full overflow-hidden">
            <!-- 140° threshold indicator at (140/180) ≈ 77.7% -->
            <div class="absolute top-0 bottom-0 left-[77.7%] w-0.5 bg-amber-400/80 z-10" title="Start Threshold 140°"></div>
            <div id="dbg-drink-meter" class="h-full bg-lime-400 rounded-full transition-all" style="width: 0%;"></div>
          </div>
          <div class="flex justify-between items-center pt-0.5">
            <span class="text-[9px] text-zinc-400">Juice Level:</span>
            <span id="dbg-juice-level" class="text-xs font-bold text-lime-400">100%</span>
          </div>
        </div>

        <!-- Timestamp & Event Counter -->
        <div class="flex justify-between items-center text-[10px] text-zinc-500 px-1 pt-0.5">
          <span>Last Update:</span>
          <span id="dbg-timestamp" class="text-zinc-400 font-mono">waiting...</span>
        </div>

        <!-- User Permission Button -->
        <button
          id="dbg-perm-btn"
          type="button"
          class="w-full mt-1.5 py-2 px-3 rounded-xl bg-lime-500 hover:bg-lime-400 text-black font-display font-bold text-xs shadow-lg transition-all active:scale-95 cursor-pointer flex items-center justify-center gap-1.5"
        >
          <span>⚡</span>
          <span id="dbg-perm-btn-text">Request / Enable Sensor Access</span>
        </button>

        <!-- Warning message if non-secure context in Chrome Android -->
        <div id="dbg-insecure-alert" class="hidden mt-1 p-1.5 rounded bg-rose-950/80 border border-rose-500/50 text-[10px] text-rose-300 leading-tight">
          ⚠️ <strong>Non-Secure Origin:</strong> Chrome on Android disables motion sensors over plain <code>http://LAN-IP</code>. Open via HTTPS or localhost to enable.
        </div>
      </div>
    </aside>

    <!-- ========================================================= -->
    <!-- VIEW 1: MINIMALIST MENU SELECTION SCREEN (CHAI BAAR STYLE)-->
    <!-- ========================================================= -->
    <main id="view-menu" class="w-full max-w-md flex flex-col items-center text-center my-auto px-4 py-6 transition-all duration-300 z-10">
      <!-- Top Navigation Header inside Menu -->
      <div class="w-full flex justify-between items-center mb-6">
        <div class="inline-block px-3.5 py-1 rounded-full border border-lime-500/30 text-lime-400 text-[10px] sm:text-[11px] font-display font-bold uppercase tracking-widest bg-lime-950/30">
          DESI TAPRI EXPERIENCE
        </div>

        <!-- Lo-Fi Ambient Player -->
        <button
          id="lofi-toggle-btn"
          type="button"
          class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-black/40 hover:bg-black/60 border border-white/10 text-white text-xs font-mono backdrop-blur-md transition-all active:scale-95 cursor-pointer shadow-lg"
          aria-label="Toggle Ambient Audio"
        >
          <span class="text-zinc-500 text-[10px]">⏭️</span>
          <span id="lofi-icon" class="text-lime-400 text-xs">▶️</span>
          <span id="lofi-text" class="text-[11px] font-medium text-zinc-200">Ganna Tapri – Later</span>
        </button>
      </div>

      <!-- Typography Header -->
      <h1 class="font-display font-black text-4xl sm:text-5xl text-transparent bg-clip-text bg-gradient-to-r from-lime-300 via-yellow-300 to-amber-400 leading-none mb-1">
        गन्ने का रस
      </h1>
      <h2 class="font-display font-black text-xl sm:text-2xl text-white tracking-widest mt-1">
        GANNA BAAR
      </h2>
      <p class="font-body text-xs sm:text-sm text-zinc-400 mt-1 font-light tracking-wide">
        The Online Ganna Break ☀️
      </p>

      <!-- Preview Static Cutting Glass Graphic -->
      <div class="relative w-40 sm:w-48 aspect-[3/4] my-4 flex items-center justify-center">
        <div class="absolute -top-2 text-lg animate-float-slow opacity-80">🍋</div>
        <div class="absolute -bottom-1 -left-2 text-base animate-float-slow opacity-80" style="animation-delay: 1.5s;">🧊</div>

        <svg viewBox="0 0 200 280" class="w-full h-full drop-shadow-2xl overflow-visible">
          <defs>
            <clipPath id="previewGlassClip">
              <polygon points="40,25 160,25 146,252 54,252" />
            </clipPath>
            <linearGradient id="previewJuiceGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#E4F78F" />
              <stop offset="35%" stop-color="#C5E038" />
              <stop offset="70%" stop-color="#99B816" />
              <stop offset="100%" stop-color="#556E0B" />
            </linearGradient>
            <linearGradient id="previewKesarGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#FFE082" />
              <stop offset="40%" stop-color="#FFB300" />
              <stop offset="80%" stop-color="#E65100" />
              <stop offset="100%" stop-color="#9C2706" />
            </linearGradient>
            <linearGradient id="previewFoam" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#FCFFE7" stop-opacity="0.95" />
              <stop offset="50%" stop-color="#F4FCC2" stop-opacity="0.98" />
              <stop offset="100%" stop-color="#FCFFE7" stop-opacity="0.95" />
            </linearGradient>
          </defs>
          <ellipse cx="100" cy="258" rx="50" ry="8" fill="rgba(0,0,0,0.6)" />
          <polygon points="38,20 162,20 148,255 52,255" fill="rgba(255, 255, 255, 0.08)" stroke="rgba(255, 255, 255, 0.25)" stroke-width="2.5" />
          <polygon points="52,242 148,242 146,254 54,254" fill="rgba(255, 255, 255, 0.25)" />
          <g clip-path="url(#previewGlassClip)">
            <rect id="preview-liquid" x="0" y="35" width="200" height="225" fill="url(#previewJuiceGrad)" />
            <circle cx="70" cy="160" r="2.5" fill="#FCFFE7" opacity="0.6" class="animate-bounce" />
            <circle cx="130" cy="180" r="3" fill="#FCFFE7" opacity="0.6" class="animate-bounce" />
            <polygon points="65,45 80,38 94,46 78,53" fill="#FFFFFF" opacity="0.75" />
            <polygon points="110,48 124,42 136,49 122,55" fill="#FFFFFF" opacity="0.75" />
            <g id="preview-mint" class="hidden">
              <circle cx="95" cy="45" r="7" fill="#48BB78" opacity="0.9" />
            </g>
            <g id="preview-kesar" class="hidden">
              <line x1="80" y1="40" x2="110" y2="46" stroke="#DC2626" stroke-width="2" />
            </g>
            <ellipse cx="100" cy="35" rx="60" ry="10" fill="url(#previewFoam)" />
            <g stroke="rgba(255, 255, 255, 0.2)" stroke-width="2.5" stroke-linecap="round">
              <line x1="62" y1="35" x2="70" y2="235" />
              <line x1="82" y1="35" x2="86" y2="235" />
              <line x1="100" y1="35" x2="100" y2="235" />
              <line x1="118" y1="35" x2="114" y2="235" />
              <line x1="138" y1="35" x2="130" y2="235" />
            </g>
          </g>
          <ellipse cx="100" cy="22" rx="62" ry="9" fill="none" stroke="rgba(255, 255, 255, 0.4)" stroke-width="2.5" />
        </svg>
      </div>

      <!-- Tapri Menu Label -->
      <span class="text-[11px] font-display font-bold text-zinc-500 uppercase tracking-widest mb-2.5">
        TAPRI MENU
      </span>

      <!-- Horizontal Menu Cards -->
      <div class="w-full grid grid-cols-3 gap-2 mb-5" id="tapri-menu-pills">
        <!-- Card 1: Saada Ras -->
        <button
          type="button"
          data-flavor="saada"
          class="tapri-pill p-3 rounded-2xl border-2 border-lime-500 bg-lime-950/40 text-left transition-all cursor-pointer shadow-md glow-green"
        >
          <span class="text-xl block mb-1">🌾</span>
          <span class="font-display font-bold text-xs sm:text-sm text-white block leading-tight">
            Saada Ras
          </span>
          <span class="text-[10px] font-body text-zinc-400 block leading-tight mt-0.5">
            100% pure mithaas
          </span>
        </button>

        <!-- Card 2: Nimbu Masala -->
        <button
          type="button"
          data-flavor="nimbu"
          class="tapri-pill p-3 rounded-2xl border-2 border-zinc-800 bg-zinc-900/40 hover:bg-zinc-900/70 text-left transition-all cursor-pointer shadow-sm"
        >
          <span class="text-xl block mb-1">🍋</span>
          <span class="font-display font-bold text-xs sm:text-sm text-white block leading-tight">
            Nimbu Masala
          </span>
          <span class="text-[10px] font-body text-zinc-400 block leading-tight mt-0.5">
            Mint & Kala Namak
          </span>
        </button>

        <!-- Card 3: Shahi Kesar -->
        <button
          type="button"
          data-flavor="kesar"
          class="tapri-pill p-3 rounded-2xl border-2 border-zinc-800 bg-zinc-900/40 hover:bg-zinc-900/70 text-left transition-all cursor-pointer shadow-sm"
        >
          <span id="kesar-icon" class="text-xl block mb-1">🔒</span>
          <span class="font-display font-bold text-xs sm:text-sm text-white block leading-tight">
            Shahi Kesar
          </span>
          <span id="kesar-desc" class="text-[10px] font-body text-zinc-400 block leading-tight mt-0.5">
            ₹10 Shagun special
          </span>
        </button>
      </div>

      <!-- Single Big CTA Button -->
      <button
        id="open-glass-btn"
        type="button"
        class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-lime-600 via-emerald-600 to-amber-500 hover:from-lime-500 hover:to-amber-400 text-white font-display font-bold text-lg shadow-lg hover:shadow-lime-500/25 transition-all transform active:scale-95 flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>Ras Nikalo — Glass Bharo! 🥤</span>
      </button>

      <!-- Bottom Privacy Tagline -->
      <footer class="w-full max-w-sm text-center mt-6">
        <p class="text-[11px] font-body text-zinc-500 leading-relaxed">
          🔒 <strong class="text-zinc-400">100% Private & In-Browser.</strong> Uses motion sensors to tilt and drink — zero data recorded.
        </p>
      </footer>
    </main>

    <!-- ========================================================= -->
    <!-- VIEW 2: DEDICATED FULL-SCREEN CHAI BAAR SCALE DRINKING VIEW -->
    <!-- ========================================================= -->
    <div
      id="view-drinking"
      class="fixed inset-0 w-full h-full hidden overflow-hidden select-none touch-none z-40 bg-[#070e04]"
    >
      <!-- Background Canvas: Full screen edge-to-edge -->
      <canvas id="liquid-physics-canvas" class="absolute inset-0 w-full h-full block"></canvas>

      <!-- Top HUD Bar: Exact Chai Baar layout -->
      <header class="absolute top-0 left-0 right-0 z-20 flex items-center justify-between px-4 pt-3.5 pb-2 pointer-events-auto">
        <button
          id="back-to-menu-btn"
          type="button"
          class="px-3.5 py-1.5 rounded-full border border-lime-500/40 bg-[#0e1b09]/85 backdrop-blur-md text-lime-400 font-display font-bold text-xs tracking-wider cursor-pointer active:scale-95 transition-all shadow-md flex items-center gap-1.5"
        >
          <span>🌾</span>
          <span>गन्ना बार</span>
        </button>

        <div class="flex items-center gap-2">
          <!-- Sips Metric Pill -->
          <div class="px-3 py-1.5 rounded-full border border-lime-500/30 bg-[#0e1b09]/85 backdrop-blur-md text-lime-300 font-display font-bold text-xs flex items-center gap-1.5 shadow-md">
            <span>🥤</span>
            <span id="sip-count-badge">0/4</span>
          </div>
          <!-- Sound Toggle -->
          <button
            id="audio-toggle-btn"
            type="button"
            class="w-8 h-8 rounded-full border border-zinc-700 bg-[#0e1b09]/85 backdrop-blur-md flex items-center justify-center text-sm cursor-pointer active:scale-95 transition-all"
            title="Toggle Sound"
          >
            <span id="sound-icon">🔊</span>
          </button>
          <!-- Restart Reset Button -->
          <button
            id="reset-btn"
            type="button"
            class="w-8 h-8 rounded-full border border-zinc-700 bg-[#0e1b09]/85 backdrop-blur-md flex items-center justify-center text-sm text-zinc-300 font-bold cursor-pointer active:scale-95 transition-all"
            title="Restart Glass"
          >
            ↺
          </button>
        </div>
      </header>

      <!-- Jukebox Player Pill: Floating at upper right (exact Chai Baar position) -->
      <div
        id="jukebox-pill"
        class="absolute top-14 right-4 z-20 flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-lime-500/30 bg-[#0e1b09]/85 backdrop-blur-md shadow-xl cursor-pointer active:scale-95 transition-all pointer-events-auto"
        title="Tap to toggle Lo-Fi music"
      >
        <div class="text-[10px] text-right leading-tight">
          <span class="text-[8px] text-amber-400 font-bold tracking-widest block">NOW PLAYING</span>
          <span id="jb-track-name" class="text-zinc-200 font-medium block">Ganna Tapri - Later</span>
        </div>
        <button id="jb-play-btn" type="button" class="text-xs text-white">▶️</button>
        <span class="text-base animate-spin" style="animation-duration: 4s;">💿</span>
      </div>

      <!-- Pouring Droplets Stream when tilted past mouth threshold -->
      <div id="pour-stream" class="absolute top-28 left-8 pointer-events-none opacity-0 transition-opacity duration-150 z-30">
        <div class="text-3xl animate-bounce">💦</div>
      </div>
      <div id="pour-stream-right" class="absolute top-28 right-8 pointer-events-none opacity-0 transition-opacity duration-150 z-30">
        <div class="text-3xl animate-bounce">💦</div>
      </div>

      <!-- Bottom HUD: Exact Chai Baar Card Layout -->
      <div class="absolute bottom-5 left-4 right-4 max-w-sm mx-auto z-20 pointer-events-auto flex flex-col gap-2">
        <div
          id="sip-tap-card"
          class="p-3.5 sm:p-4 rounded-3xl bg-[#0e1b09]/90 border border-lime-500/30 flex items-center gap-3.5 backdrop-blur-md shadow-2xl transition-all active:scale-95 cursor-pointer"
          title="Tap to take a sip or tilt phone to mouth"
        >
          <div id="sip-flavor-icon" class="w-11 h-11 rounded-2xl bg-lime-950/60 border border-lime-500/40 flex items-center justify-center text-2xl shrink-0 shadow-inner">
            🥤
          </div>
          <div class="text-left flex-1">
            <div id="sip-card-title" class="font-display font-bold text-white text-base leading-tight">
              Chuski Lo — Asli Sukoon
            </div>
            <div id="sip-card-desc" class="font-body text-xs text-zinc-400 mt-0.5 leading-snug">
              Hold the phone like a real glass and tilt it towards your mouth to sip!
            </div>
          </div>
        </div>

        <!-- Victory Replay Button (When finished) -->
        <button
          id="finish-replay-btn"
          type="button"
          class="hidden w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-lime-600 via-emerald-600 to-amber-500 hover:from-lime-500 hover:to-amber-400 text-white font-display font-black text-base shadow-xl transition-all transform active:scale-95 items-center justify-center gap-2 cursor-pointer"
        >
          <span>Ek Aur Glass Ho Jaaye! 🔁</span>
        </button>
      </div>
    </div>

    <!-- Shagun Honor Unlock Modal (Kesar Flavor) -->
    <div
      id="shagun-modal"
