---
// Ganna Baar - Ultra-Minimalist Cane Juice Web Toy
// Full viewport drinking glass with real-time 2D fluid wave & sloshing physics,
// true multi-point wave surface tension, inertia, and mouth-tilt sensor detection.
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO & Metadata -->
    <title>GANNA BAAR — The Online Sugarcane Break</title>
    <meta
      name="description"
      content="The Online Sugarcane Break ☀️ — Interactive web toy with real fluid physics. Tilt your phone to sip fresh sugarcane juice!"
    />
    <meta name="theme-color" content="#070e04" />

    <!-- Open Graph Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="GANNA BAAR — The Online Sugarcane Break" />
    <meta
      property="og:description"
      content="The Online Sugarcane Break ☀️ — Real fluid physics toy. Tilt your phone to sip fresh sugarcane juice!"
    />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="GANNA BAAR — The Online Sugarcane Break" />
    <meta name="twitter:image" content="/og.png" />

    <!-- Google Fonts: Baloo 2 + Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800;900&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#070e04] text-zinc-100 flex flex-col justify-between items-center relative select-none overflow-x-hidden">
    <!-- Ambient Sugarcane Aura -->
    <div class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[380px] sm:w-[500px] h-[380px] sm:h-[500px] bg-gradient-to-tr from-lime-600/20 via-yellow-400/15 to-transparent rounded-full blur-3xl pointer-events-none -z-10"></div>

    <!-- Hidden YouTube Audio Host (Zero Visible UI, 100% Legal Embed) -->
    <div
      id="yt-audio-container"
      class="fixed bottom-0 right-0 w-8 h-8 opacity-[0.001] pointer-events-none overflow-hidden z-0"
      aria-hidden="true"
      tabindex="-1"
    >
      <div id="yt-player"></div>
    </div>

    <!-- Quick Toast Notification -->
    <div
      id="app-toast"
      class="fixed top-5 left-1/2 -translate-x-1/2 z-50 px-4 py-2 rounded-full bg-zinc-950 text-lime-300 font-display text-xs font-bold border border-lime-500/40 opacity-0 pointer-events-none transition-all duration-300 shadow-xl"
    >
      Link Copied! 🌾
    </div>

    <!-- ========================================================= -->
    <!-- VIEW 1: MINIMALIST MENU SELECTION SCREEN -->
    <!-- ========================================================= -->
    <main id="view-menu" class="w-full max-w-md flex flex-col items-center text-center my-auto px-4 py-6 transition-all duration-300 z-10">
      <!-- Top Navigation Header inside Menu -->
      <div class="w-full flex justify-between items-center mb-6">
        <div class="inline-block px-3.5 py-1 rounded-full border border-lime-500/30 text-lime-400 text-[10px] sm:text-[11px] font-display font-bold uppercase tracking-widest bg-lime-950/30">
          AUTHENTIC CANE EXPERIENCE
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2">
          <!-- Play / Resume / Pause Button -->
          <button
            id="menu-play-pause-btn"
            type="button"
            class="w-8 h-8 rounded-full border border-lime-500/40 bg-black/60 hover:bg-black/80 backdrop-blur-md flex items-center justify-center text-xs text-lime-300 cursor-pointer active:scale-95 transition-all shadow-md"
            title="Play / Pause Music"
            aria-label="Play or Pause Music"
          >
            <span id="menu-play-icon">⏸️</span>
          </button>

          <!-- Stop Button -->
          <button
            id="menu-stop-btn"
            type="button"
            class="w-8 h-8 rounded-full border border-zinc-700 bg-black/50 hover:bg-black/70 backdrop-blur-md flex items-center justify-center text-xs text-zinc-300 cursor-pointer active:scale-95 transition-all shadow-md"
            title="Stop Music (Reset to 0:00)"
            aria-label="Stop Music"
          >
            <span>⏹️</span>
          </button>

          <!-- YouTube Music Player Switcher -->
          <button
            id="lofi-toggle-btn"
            type="button"
            class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-black/40 hover:bg-black/60 border border-white/10 text-white text-xs font-mono backdrop-blur-md transition-all active:scale-95 cursor-pointer shadow-lg"
            title="Switch to next background song"
            aria-label="Switch Background Music"
          >
            <span class="text-xs text-lime-400">🔄</span>
            <span id="lofi-text" class="text-[11px] font-medium text-zinc-200 max-w-[80px] sm:max-w-none truncate">Ganne Ka Juice</span>
          </button>

          <!-- Mute / Unmute Button -->
          <button
            id="menu-mute-btn"
            type="button"
            class="w-8 h-8 rounded-full border border-zinc-700 bg-black/50 hover:bg-black/70 backdrop-blur-md flex items-center justify-center text-sm cursor-pointer active:scale-95 transition-all shadow-md"
            title="Mute / Unmute Sound"
            aria-label="Toggle Sound"
          >
            <span id="menu-sound-icon">🔊</span>
          </button>
        </div>
      </div>

      <!-- Typography Header -->
      <h1 class="font-display font-black text-4xl sm:text-5xl text-transparent bg-clip-text bg-gradient-to-r from-lime-300 via-yellow-300 to-amber-400 leading-none mb-1">
        FRESH CANE JUICE
      </h1>
      <h2 class="font-display font-black text-xl sm:text-2xl text-white tracking-widest mt-1">
        GANNA BAAR
      </h2>
      <p class="font-body text-xs sm:text-sm text-zinc-400 mt-1 font-light tracking-wide">
        The Online Sugarcane Break ☀️
      </p>

      <!-- Preview Static Cutting Glass Graphic -->
      <div id="preview-glass-container" class="relative w-40 sm:w-48 aspect-[3/4] my-4 flex items-center justify-center transition-transform duration-300 ease-out origin-bottom">
        <div class="absolute -top-2 text-lg animate-float-slow opacity-80">🍋</div>
        <div class="absolute -bottom-1 -left-2 text-base animate-float-slow opacity-80" style="animation-delay: 1.5s;">🧊</div>

        <svg viewBox="0 0 200 280" class="w-full h-full drop-shadow-2xl overflow-visible">
          <defs>
            <clipPath id="previewGlassClip">
              <polygon points="40,25 160,25 146,252 54,252" />
            </clipPath>
            <linearGradient id="previewJuiceGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#E4F78F" />
              <stop offset="35%" stop-color="#C5E038" />
              <stop offset="70%" stop-color="#99B816" />
              <stop offset="100%" stop-color="#556E0B" />
            </linearGradient>
            <linearGradient id="previewFoam" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#FCFFE7" stop-opacity="0.95" />
              <stop offset="50%" stop-color="#F4FCC2" stop-opacity="0.98" />
              <stop offset="100%" stop-color="#FCFFE7" stop-opacity="0.95" />
            </linearGradient>
          </defs>
          <ellipse cx="100" cy="258" rx="50" ry="8" fill="rgba(0,0,0,0.6)" />
          <polygon points="38,20 162,20 148,255 52,255" fill="rgba(255, 255, 255, 0.08)" stroke="rgba(255, 255, 255, 0.25)" stroke-width="2.5" />
          <polygon points="52,242 148,242 146,254 54,254" fill="rgba(255, 255, 255, 0.25)" />
          <g clip-path="url(#previewGlassClip)">
            <rect id="preview-liquid" x="0" y="35" width="200" height="225" fill="url(#previewJuiceGrad)" />
            <circle cx="70" cy="160" r="2.5" fill="#FCFFE7" opacity="0.6" class="animate-bounce" />
            <circle cx="130" cy="180" r="3" fill="#FCFFE7" opacity="0.6" class="animate-bounce" />
            <polygon points="65,45 80,38 94,46 78,53" fill="#FFFFFF" opacity="0.75" />
            <polygon points="110,48 124,42 136,49 122,55" fill="#FFFFFF" opacity="0.75" />
            <g id="preview-mint" class="hidden">
              <circle cx="95" cy="45" r="7" fill="#48BB78" opacity="0.9" />
            </g>
            <ellipse cx="100" cy="35" rx="60" ry="10" fill="url(#previewFoam)" />
            <g stroke="rgba(255, 255, 255, 0.2)" stroke-width="2.5" stroke-linecap="round">
              <line x1="62" y1="35" x2="70" y2="235" />
              <line x1="82" y1="35" x2="86" y2="235" />
              <line x1="100" y1="35" x2="100" y2="235" />
              <line x1="118" y1="35" x2="114" y2="235" />
              <line x1="138" y1="35" x2="130" y2="235" />
            </g>
          </g>
          <ellipse cx="100" cy="22" rx="62" ry="9" fill="none" stroke="rgba(255, 255, 255, 0.4)" stroke-width="2.5" />
        </svg>
      </div>

      <!-- Which glass would you like? Glass Size Selection -->
      <div class="w-full mb-4">
        <h3 class="text-sm sm:text-base font-display font-extrabold text-white tracking-wide mb-0.5 flex items-center justify-center gap-2">
          <span>Which glass would you like?</span>
        </h3>
        <p class="text-[11px] font-body text-zinc-400 mb-2.5">
          Select your size to pour
        </p>

        <!-- 3 Glass Size Options -->
        <div class="grid grid-cols-3 gap-2.5 w-full" id="glass-size-selector">
          <!-- Option 1: Small (20) -->
          <button
            type="button"
            data-size="small"
            data-amount="20"
            class="glass-size-card p-3 rounded-2xl border-2 transition-all cursor-pointer flex flex-col items-center justify-between border-zinc-800 bg-zinc-900/40 hover:bg-zinc-900/70 shadow-sm"
          >
            <span class="text-2xl block mb-1">🥃</span>
            <span class="font-display font-bold text-xs sm:text-sm text-white block leading-tight">Small</span>
            <span class="size-val-badge mt-2 px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-zinc-800/80 text-zinc-300 border border-zinc-700">
              20
            </span>
          </button>

          <!-- Option 2: Medium (40) - Default Selected -->
          <button
            type="button"
            data-size="medium"
            data-amount="40"
            class="glass-size-card p-3 rounded-2xl border-2 transition-all cursor-pointer flex flex-col items-center justify-between border-lime-500 bg-lime-950/40 glow-green shadow-md ring-1 ring-lime-400/40"
          >
            <span class="text-2xl block mb-1">🥛</span>
            <span class="font-display font-bold text-xs sm:text-sm text-white block leading-tight">Medium</span>
            <span class="size-val-badge mt-2 px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-lime-900/80 text-lime-300 border border-lime-500/50">
              40
            </span>
          </button>

          <!-- Option 3: Large (50) -->
          <button
            type="button"
            data-size="large"
            data-amount="50"
            class="glass-size-card p-3 rounded-2xl border-2 transition-all cursor-pointer flex flex-col items-center justify-between border-zinc-800 bg-zinc-900/40 hover:bg-zinc-900/70 shadow-sm"
          >
            <span class="text-2xl block mb-1">🍹</span>
            <span class="font-display font-bold text-xs sm:text-sm text-white block leading-tight">Large</span>
            <span class="size-val-badge mt-2 px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-zinc-800/80 text-zinc-300 border border-zinc-700">
              50
            </span>
          </button>
        </div>
      </div>

      <!-- Juice Menu Label -->
      <span class="text-[11px] font-display font-bold text-zinc-500 uppercase tracking-widest mb-2.5">
        CHOOSE FLAVOR
      </span>

      <!-- Horizontal Menu Cards (2 Flavors) -->
      <div class="w-full grid grid-cols-2 gap-3 mb-5" id="tapri-menu-pills">
        <!-- Card 1: Classic Cane -->
        <button
          type="button"
          data-flavor="saada"
          class="tapri-pill p-3 rounded-2xl border-2 border-lime-500 bg-lime-950/40 text-left transition-all cursor-pointer shadow-md glow-green"
        >
          <span class="text-xl block mb-1">🌾</span>
          <span class="font-display font-bold text-xs sm:text-sm text-white block leading-tight">
            Classic Cane
          </span>
          <span class="text-[10px] font-body text-zinc-400 block leading-tight mt-0.5">
            100% pure & sweet
          </span>
        </button>

        <!-- Card 2: Lemon & Mint -->
        <button
          type="button"
          data-flavor="nimbu"
          class="tapri-pill p-3 rounded-2xl border-2 border-zinc-800 bg-zinc-900/40 hover:bg-zinc-900/70 text-left transition-all cursor-pointer shadow-sm"
        >
          <span class="text-xl block mb-1">🍋</span>
          <span class="font-display font-bold text-xs sm:text-sm text-white block leading-tight">
            Lemon & Mint
          </span>
          <span class="text-[10px] font-body text-zinc-400 block leading-tight mt-0.5">
            Fresh mint & rock salt
          </span>
        </button>
      </div>

      <!-- Single Big CTA Button -->
      <button
        id="open-glass-btn"
        type="button"
        class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-lime-600 via-emerald-600 to-amber-500 hover:from-lime-500 hover:to-amber-400 text-white font-display font-bold text-lg shadow-lg hover:shadow-lime-500/25 transition-all transform active:scale-95 flex items-center justify-center gap-2 cursor-pointer"
      >
        <span id="cta-btn-text">Pour Medium Glass (40) — Fill! 🥤</span>
      </button>

      <!-- Bottom Privacy Tagline -->
      <footer class="w-full max-w-sm text-center mt-6">
        <p class="text-[11px] font-body text-zinc-500 leading-relaxed">
          🔒 <strong class="text-zinc-400">100% Private & In-Browser.</strong> Uses motion sensors to tilt and drink — zero data recorded.
        </p>
      </footer>
    </main>

    <!-- ========================================================= -->
    <!-- VIEW 2: DEDICATED FULL-SCREEN DRINKING VIEW -->
    <!-- ========================================================= -->
    <div
      id="view-drinking"
      class="fixed inset-0 w-full h-full hidden overflow-hidden select-none touch-none z-40 bg-[#070e04]"
    >
      <!-- Background Canvas: Full screen edge-to-edge -->
      <canvas id="liquid-physics-canvas" class="absolute inset-0 w-full h-full block cursor-pointer"></canvas>

      <!-- Top HUD Bar -->
      <header class="absolute top-0 left-0 right-0 z-20 flex items-center justify-between px-4 pt-3.5 pb-2 pointer-events-auto">
        <button
          id="back-to-menu-btn"
          type="button"
          class="px-3.5 py-1.5 rounded-full border border-lime-500/40 bg-[#0e1b09]/85 backdrop-blur-md text-lime-400 font-display font-bold text-xs tracking-wider cursor-pointer active:scale-95 transition-all shadow-md flex items-center gap-1.5"
        >
          <span>🌾</span>
          <span>GANNA BAAR</span>
        </button>

        <div class="flex items-center gap-2">
          <!-- Sips Metric Pill -->
          <div class="px-3 py-1.5 rounded-full border border-lime-500/30 bg-[#0e1b09]/85 backdrop-blur-md text-lime-300 font-display font-bold text-xs flex items-center gap-1.5 shadow-md">
            <span>🥤</span>
            <span id="sip-count-badge">100%</span>
          </div>
          <!-- Sound Toggle -->
          <button
            id="audio-toggle-btn"
            type="button"
            class="w-8 h-8 rounded-full border border-zinc-700 bg-[#0e1b09]/85 backdrop-blur-md flex items-center justify-center text-sm cursor-pointer active:scale-95 transition-all"
            title="Mute / Unmute Sound"
          >
            <span id="sound-icon">🔊</span>
          </button>
          <!-- Restart Reset Button -->
          <button
            id="reset-btn"
            type="button"
            class="w-8 h-8 rounded-full border border-zinc-700 bg-[#0e1b09]/85 backdrop-blur-md flex items-center justify-center text-sm text-zinc-300 font-bold cursor-pointer active:scale-95 transition-all"
            title="Refill Glass"
          >
            ↺
          </button>
        </div>
      </header>

      <!-- Jukebox Player Bar: Floating at upper right -->
      <div
        id="jukebox-pill"
        class="absolute top-14 right-4 z-20 flex items-center gap-2 px-3 py-1.5 rounded-full border border-lime-500/30 bg-[#0e1b09]/90 backdrop-blur-md shadow-xl pointer-events-auto transition-all"
      >
        <div class="text-[10px] text-right leading-tight pr-1.5 border-r border-zinc-800">
          <span class="text-[8px] text-amber-400 font-bold tracking-widest block">MUSIC</span>
          <span id="jb-track-name" class="text-zinc-200 font-medium block max-w-[80px] truncate">Ganne Ka Juice</span>
        </div>
        <!-- Play / Pause -->
        <button id="jb-play-pause-btn" type="button" class="text-xs hover:scale-110 active:scale-95 transition-all cursor-pointer p-0.5" title="Play / Pause">
          <span id="jb-play-icon">⏸️</span>
        </button>
        <!-- Stop -->
        <button id="jb-stop-btn" type="button" class="text-xs hover:scale-110 active:scale-95 transition-all cursor-pointer p-0.5" title="Stop (Reset to Start)">
          <span>⏹️</span>
        </button>
        <!-- Next Track -->
        <button id="jb-next-btn" type="button" class="text-xs hover:scale-110 active:scale-95 transition-all cursor-pointer p-0.5" title="Switch to Next Song">
          <span>🔄</span>
        </button>
        <!-- Spinning Disc -->
        <span id="jb-disc-icon" class="text-sm animate-spin" style="animation-duration: 4s;">💿</span>
      </div>

      <!-- Pouring Droplets Stream when tilted past mouth threshold -->
      <div id="pour-stream" class="absolute top-28 left-8 pointer-events-none opacity-0 transition-opacity duration-150 z-30">
        <div class="text-3xl animate-bounce">💦</div>
      </div>
      <div id="pour-stream-right" class="absolute top-28 right-8 pointer-events-none opacity-0 transition-opacity duration-150 z-30">
        <div class="text-3xl animate-bounce">💦</div>
      </div>

      <!-- Bottom HUD: Glass Action Card -->
      <div class="absolute bottom-5 left-4 right-4 max-w-sm mx-auto z-20 pointer-events-auto flex flex-col gap-2">
        <div
          id="sip-tap-card"
          class="p-3.5 sm:p-4 rounded-3xl bg-[#0e1b09]/90 border border-lime-500/30 flex items-center gap-3.5 backdrop-blur-md shadow-2xl transition-all active:scale-95 cursor-pointer"
          title="Tap here or tap the glass to take a sip"
        >
          <div id="sip-flavor-icon" class="w-11 h-11 rounded-2xl bg-lime-950/60 border border-lime-500/40 flex items-center justify-center text-2xl shrink-0 shadow-inner">
            🥤
          </div>
          <div class="text-left flex-1">
            <div id="sip-card-title" class="font-display font-bold text-white text-base leading-tight">
              Take a Sip — Pure Refreshment
            </div>
            <div id="sip-card-desc" class="font-body text-xs text-zinc-400 mt-0.5 leading-snug">
              Hold phone like a real glass & tilt to drink, or tap the glass!
            </div>
          </div>
        </div>

        <!-- Victory Replay Button (When finished) -->
        <button
          id="finish-replay-btn"
          type="button"
          class="hidden w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-lime-600 via-emerald-600 to-amber-500 hover:from-lime-500 hover:to-amber-400 text-white font-display font-black text-base shadow-xl transition-all transform active:scale-95 items-center justify-center gap-2 cursor-pointer"
        >
          <span>Pour Another Glass! 🔁</span>
        </button>
      </div>
    </div>

    <!-- ========================================================= -->
    <!-- CHAI BAAR EXACT MULTI-SENSOR GYROSCOPE TRACKER & FLUID ENGINE -->
    <!-- ========================================================= -->
    <script>
      import { soundEngine } from '../scripts/audio';

      // Flavors definition (Saada Classic & Nimbu Masala)
      type Flavor = 'saada' | 'nimbu';
      let selectedFlavor: Flavor = 'saada';
      let isFinished = false;

      // Centralized Glass Configuration: Small (20), Medium (40), Large (50)
      type GlassSize = 'small' | 'medium' | 'large';
      interface GlassSpec {
        name: string;
        amount: number;
        icon: string;
        drainRate: number;
        widthFactor: number;    // Glass top width as fraction of max container
        topRimFraction: number; // Glass top rim Y as fraction of viewport height
        bottomPad: number;      // Base thickness pad
        previewScale: string;   // Preview scale for menu SVG
      }

      const GLASS_CONFIG: Record<GlassSize, GlassSpec> = {
        small: {
          name: 'Small',
          amount: 20,
          icon: '🥃',
          drainRate: 0.22,
          widthFactor: 0.62,       // Visibly smaller/narrower cutting tumbler
          topRimFraction: 0.25,    // Visibly shorter height (starts 25% from top)
          bottomPad: 46,
          previewScale: 'scale(0.80)',
        },
        medium: {
          name: 'Medium',
          amount: 40,
          icon: '🥛',
          drainRate: 0.17,
          widthFactor: 0.80,       // Standard cutting glass
          topRimFraction: 0.14,    // Standard top rim (14% from top)
          bottomPad: 58,
          previewScale: 'scale(1.0)',
        },
        large: {
          name: 'Large',
          amount: 50,
          icon: '🍹',
          drainRate: 0.14,
          widthFactor: 0.94,       // Wide, spacious, tall glass
          topRimFraction: 0.07,    // Tall glass (starts 7% from top)
          bottomPad: 68,
          previewScale: 'scale(1.18)',
        },
      };
      let selectedGlassSize: GlassSize = 'medium';
      let currentCapacity = GLASS_CONFIG.medium.amount; // 40

      // Views & Elements
      const viewMenu = document.getElementById('view-menu');
      const viewDrinking = document.getElementById('view-drinking');
      const backToMenuBtn = document.getElementById('back-to-menu-btn');
      const openGlassBtn = document.getElementById('open-glass-btn');
      const ctaBtnText = document.getElementById('cta-btn-text');
      const sipTapCard = document.getElementById('sip-tap-card');
      const sipFlavorIcon = document.getElementById('sip-flavor-icon');
      const sipCardTitle = document.getElementById('sip-card-title');
      const sipCardDesc = document.getElementById('sip-card-desc');
      const sipCountBadge = document.getElementById('sip-count-badge');
      const audioToggleBtn = document.getElementById('audio-toggle-btn');
      const soundIcon = document.getElementById('sound-icon');
      const resetBtn = document.getElementById('reset-btn');
      const finishReplayBtn = document.getElementById('finish-replay-btn');
      const pourStreamLeft = document.getElementById('pour-stream');
      const pourStreamRight = document.getElementById('pour-stream-right');

      // Music Player Elements (Menu Header)
      const menuPlayPauseBtn = document.getElementById('menu-play-pause-btn');
      const menuPlayIcon = document.getElementById('menu-play-icon');
      const menuStopBtn = document.getElementById('menu-stop-btn');
      const menuMuteBtn = document.getElementById('menu-mute-btn');
      const menuSoundIcon = document.getElementById('menu-sound-icon');
      const lofiToggleBtn = document.getElementById('lofi-toggle-btn');
      const lofiText = document.getElementById('lofi-text');

      // Music Player Elements (Drinking View HUD)
      const jbTrackName = document.getElementById('jb-track-name');
      const jbPlayPauseBtn = document.getElementById('jb-play-pause-btn');
      const jbPlayIcon = document.getElementById('jb-play-icon');
      const jbStopBtn = document.getElementById('jb-stop-btn');
