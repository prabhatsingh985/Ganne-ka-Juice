      // =========================================================
      // TRUE PHYSICAL SENSOR MANAGER (ZERO FAKING)
      // Reads purely physical hardware motion & orientation
      // =========================================================
      class SensorManager {
        public status: 'unsupported' | 'permission-required' | 'denied' | 'active' = 'permission-required';
        public source: 'orientation' | 'orientationabsolute' | 'motion' | 'none' = 'none';

        // Raw physical orientation values from hardware
        public rawAlpha: number | null = null;
        public rawBeta: number | null = null;
        public rawGamma: number | null = null;

        // Raw physical gravity vector (m/s²) from accelerometer
        public gravityX: number | null = null;
        public gravityY: number | null = null;
        public gravityZ: number | null = null;

        // Smoothed physical orientation values
        // smoothGamma (Roll): negative when tilted left, positive when tilted right
        // smoothBeta (Pitch): upright is ~70-85°, flat is 0°, drinking tilt is >= 100°
        public smoothGamma: number = 0;
        public smoothBeta: number = 75;
        public smoothAccY: number = 9.8;

        // Calibrated upright baselines
        public baseBeta: number = 75;
        public baseGamma: number = 0;
        public baseAccY: number = 9.8;
        public isCalibrated: boolean = false;

        // Calculated tilt for liquid sloshing
        public calculatedTiltX: number = 0; // Roll in degrees
        public calculatedTiltY: number = 75; // Pitch in degrees

        // Upside-Down drinking state with strict physical hysteresis
        public isDrinking: boolean = false;

        private hasAttachedListeners = false;
        private lastFilterMs = performance.now();

        constructor() {
          this.checkSupport();
        }

        public checkSupport() {
          if (typeof window === 'undefined') return;

          const hasOrient = 'DeviceOrientationEvent' in window;
          const hasMotion = 'DeviceMotionEvent' in window;

          if (!hasOrient && !hasMotion) {
            this.status = 'unsupported';
            return;
          }

          const DOE = (window as any).DeviceOrientationEvent;
          const DME = (window as any).DeviceMotionEvent;
          const needsPermission =
            (DOE && typeof DOE.requestPermission === 'function') ||
            (DME && typeof DME.requestPermission === 'function');

          if (needsPermission) {
            this.status = 'permission-required';
          } else {
            this.attachListeners();
          }
        }

        public async requestAccess(): Promise<boolean> {
          const DOE = (window as any).DeviceOrientationEvent;
          const DME = (window as any).DeviceMotionEvent;

          let granted = false;
          if (DOE && typeof DOE.requestPermission === 'function') {
            try {
              const res = await DOE.requestPermission();
              if (res === 'granted') {
                granted = true;
              } else {
                this.status = 'denied';
                return false;
              }
            } catch (err) {
              console.warn('Orientation permission error:', err);
              this.status = 'denied';
              return false;
            }
          } else {
            granted = true;
          }

          if (DME && typeof DME.requestPermission === 'function') {
            try {
              await DME.requestPermission();
            } catch (e) {}
          }

          this.attachListeners();
          return granted;
        }

        public attachListeners() {
          if (this.hasAttachedListeners || typeof window === 'undefined') return;
          this.hasAttachedListeners = true;

          // 1. Standard DeviceOrientation Event
          window.addEventListener(
            'deviceorientation',
            (e: DeviceOrientationEvent) => {
              this.handleOrientation(e, 'orientation');
            },
            { passive: true }
          );

          // 2. DeviceOrientationAbsolute Event (Android Chrome)
          window.addEventListener(
            'deviceorientationabsolute' as any,
            (e: any) => {
              this.handleOrientation(e, 'orientationabsolute');
            },
            { passive: true }
          );

          // 3. DeviceMotionEvent (accelerationIncludingGravity fallback)
          window.addEventListener(
            'devicemotion',
            (e: DeviceMotionEvent) => {
              this.handleMotion(e);
            },
            { passive: true }
          );
        }

        public calibrate() {
          this.baseBeta = this.smoothBeta;
          this.baseGamma = this.smoothGamma;
          this.baseAccY = this.smoothAccY;
          this.isCalibrated = true;
        }

        private handleOrientation(e: DeviceOrientationEvent, src: 'orientation' | 'orientationabsolute') {
          if (e.beta === null || e.gamma === null) return;

          this.status = 'active';
          this.source = src;

          this.rawAlpha = e.alpha !== null ? Math.round(e.alpha * 10) / 10 : null;
          this.rawBeta = Math.round(e.beta * 10) / 10;
          this.rawGamma = Math.round(e.gamma * 10) / 10;

          // Handle screen orientation rotation (portrait vs landscape)
          const screenAngle = (window.screen?.orientation?.angle) ?? ((window as any).orientation as number) ?? 0;
          let roll = e.gamma;
          let pitch = e.beta;

          if (screenAngle === 90) {
            roll = pitch;
            pitch = -e.gamma;
          } else if (screenAngle === -90 || screenAngle === 270) {
            roll = -pitch;
            pitch = e.gamma;
          } else if (screenAngle === 180) {
            roll = -roll;
            pitch = -pitch;
          }

          const now = performance.now();
          const dt = Math.min((now - this.lastFilterMs) / 1000, 0.05);
          this.lastFilterMs = now;
          const lerpRate = 1 - Math.pow(0.20, dt * 60);

          this.smoothGamma += (roll - this.smoothGamma) * lerpRate;
          this.smoothBeta += (pitch - this.smoothBeta) * lerpRate;

          this.calculatedTiltX = this.smoothGamma;
          this.calculatedTiltY = this.smoothBeta;

          this.updateDrinkingState();
        }

        private handleMotion(e: DeviceMotionEvent) {
          const acc = e.accelerationIncludingGravity;
          if (!acc || typeof acc.x !== 'number' || typeof acc.y !== 'number') return;
          if (acc.x === 0 && acc.y === 0 && (acc.z === 0 || acc.z === null)) return;

          this.gravityX = acc.x;
          this.gravityY = acc.y;
          this.gravityZ = acc.z ?? 0;

          const now = performance.now();
          const dt = Math.min((now - this.lastFilterMs) / 1000, 0.05);
          this.lastFilterMs = now;
          const lerpRate = 1 - Math.pow(0.20, dt * 60);

          this.smoothAccY += (acc.y - this.smoothAccY) * lerpRate;

          // Fallback if orientation event is not sending data
          if (this.source !== 'orientation' && this.source !== 'orientationabsolute') {
            this.status = 'active';
            this.source = 'motion';

            const rollRad = Math.atan2(-acc.x, Math.max(1.0, Math.abs(acc.y)));
            const pitchRad = Math.atan2(Math.abs(acc.z ?? 0), acc.y);

            const derivedGamma = (rollRad * 180) / Math.PI;
            const derivedBeta = (pitchRad * 180) / Math.PI;

            this.smoothGamma += (derivedGamma - this.smoothGamma) * lerpRate;
            this.smoothBeta += (derivedBeta - this.smoothBeta) * lerpRate;

            this.calculatedTiltX = this.smoothGamma;
            this.calculatedTiltY = this.smoothBeta;

            this.updateDrinkingState();
          }
        }

        private updateDrinkingState() {
          if (!this.isDrinking) {
            if (this.isTiltedToDrink()) {
              this.isDrinking = true;
            }
          } else {
            if (this.isPhoneLowered()) {
              this.isDrinking = false;
            }
          }
        }

        /**
         * Physical drinking check:
         * Only activates when phone is physically tilted backward towards mouth / upside-down
         * (i.e. bottom of phone raised towards ceiling, top of phone tilted down into mouth).
         * Normal upright position (~70-85°), left/right tilt, flat, or forward tilt will NEVER activate drinking.
         */
        public isTiltedToDrink(): boolean {
          if (this.source === 'orientation' || this.source === 'orientationabsolute') {
            return this.smoothBeta >= 100;
          }
          if (this.source === 'motion') {
            if (this.baseAccY >= 0) {
              return this.smoothAccY < 2.5;
            } else {
              return this.smoothAccY > -2.5;
            }
          }
          return false;
        }

        /**
         * Checks if phone has been lowered back to normal upright/viewing position
         */
        public isPhoneLowered(): boolean {
          if (this.source === 'orientation' || this.source === 'orientationabsolute') {
            return this.smoothBeta <= 82;
          }
          if (this.source === 'motion') {
            if (this.baseAccY >= 0) {
              return this.smoothAccY > 6.0;
            } else {
              return this.smoothAccY < -6.0;
            }
          }
          return true;
        }
      }

      const sensorManager = new SensorManager();

      // =========================================================
      // CHAI BAAR EXACT FULL-SCREEN LIQUID RENDERER
      // Full screen edge-to-edge canvas with true tapri glass tumbler geometry,
      // 36 spring surface nodes, dynamic wave slosh, froth ribbon, and bubbles
      // =========================================================
      class LiquidRenderer {
        private canvas: HTMLCanvasElement;
        private ctx: CanvasRenderingContext2D;

        public nodeCount = 36;
        public nodes: Array<{ x: number; y: number; targetY: number; vy: number }> = [];
        public k = 0.022;       // Gentle spring tension
        public damping = 0.088; // Viscous fluid damping
        public spread = 0.14;   // Neighbor wave propagation

        public juiceLevel = 1.0;       // 1.0 = full, 0.0 = empty
        public targetJuiceLevel = 1.0;
        public tiltAngle = 0;          // Radians
        public topRimY = 115;          // Glass top rim Y coordinate
        public glassBottomPad = 60;    // Glass base pad

        // Geometry cache
        public glassTx1 = 0;
        public glassTx2 = 0;
        public glassBx1 = 0;
        public glassBx2 = 0;

        // Floating bubbles & froth specks
        public bubbles: Array<{ x: number; y: number; radius: number; speed: number; wobble: number; wobbleSpeed: number }> = [];
        public frothSpecks: Array<{ nodePct: number; offsetY: number; radius: number }> = [];

        constructor(canvas: HTMLCanvasElement) {
          this.canvas = canvas;
          this.ctx = canvas.getContext('2d')!;
          this.resize();
          this.initNodes();
          this.initBubbles();
          this.initFroth();
        }

        public resize() {
          const w = window.innerWidth;
          const h = window.innerHeight;
          const dpr = Math.min(window.devicePixelRatio || 1, 2);

          this.canvas.width = w * dpr;
          this.canvas.height = h * dpr;
          this.canvas.style.width = w + 'px';
          this.canvas.style.height = h + 'px';
          this.ctx.resetTransform();
          this.ctx.scale(dpr, dpr);

          // Glass geometry: 88% width at top, 62% width at bottom
          const topW = Math.min(w * 0.88, 480);
          const bottomW = Math.min(w * 0.62, 340);
          this.glassTx1 = (w - topW) / 2;
          this.glassTx2 = w - this.glassTx1;
          this.glassBx1 = (w - bottomW) / 2;
          this.glassBx2 = w - this.glassBx1;
          this.topRimY = 115;

          this.initNodes();
        }

        public initNodes() {
          this.nodes = [];
          const w = window.innerWidth;
          const baseSurfaceY = this.topRimY + 45;

          for (let i = 0; i < this.nodeCount; i++) {
            this.nodes.push({
              x: (w / (this.nodeCount - 1)) * i,
              y: baseSurfaceY,
              targetY: baseSurfaceY,
              vy: 0,
            });
          }
        }

        public initBubbles() {
          this.bubbles = [];
          for (let i = 0; i < 28; i++) {
            this.bubbles.push({
              x: 0.1 + Math.random() * 0.8,
              y: 0.3 + Math.random() * 0.6,
              radius: 1.5 + Math.random() * 3.0,
              speed: 35 + Math.random() * 55,
              wobble: Math.random() * Math.PI * 2,
              wobbleSpeed: 2.0 + Math.random() * 3.0,
            });
          }
        }

        public initFroth() {
          this.frothSpecks = [];
          for (let i = 0; i < 35; i++) {
            this.frothSpecks.push({
              nodePct: Math.random(),
              offsetY: -3 + Math.random() * 10,
              radius: 2 + Math.random() * 4.0,
            });
          }
        }

        public splash(centerNormalizedX: number, velocity: number) {
          const centerIdx = Math.floor(centerNormalizedX * (this.nodeCount - 1));
          const radius = 4;
          for (let i = Math.max(0, centerIdx - radius); i <= Math.min(this.nodeCount - 1, centerIdx + radius); i++) {
            const dist = Math.abs(i - centerIdx);
            const factor = Math.cos((dist / radius) * (Math.PI / 2));
            if (this.nodes[i]) {
              this.nodes[i].vy += velocity * factor;
            }
          }
        }

        public update(roll: number, dt: number) {
          dt = Math.min(dt, 0.1);
          const w = window.innerWidth;
          const h = window.innerHeight;

          // Smooth liquid drainage level
          const juiceLerp = 1 - Math.pow(0.08, dt * 60);
          this.juiceLevel += (this.targetJuiceLevel - this.juiceLevel) * juiceLerp;

          // Responsive tilt tracking with fluid momentum
          const tiltDamping = 1 - Math.pow(0.35, dt * 60);
          this.tiltAngle += (roll - this.tiltAngle) * tiltDamping;

          // Equilibrium line
          const bottomY = h - 20;
          const emptyY = bottomY - this.glassBottomPad;
          const fullY = this.topRimY + 45;
          const currentBaseY = fullY + (emptyY - fullY) * (1 - this.juiceLevel);

          // Clamped tilt slope:
          // Negative roll (phone tilted left) => liquid rises on the left side of screen
          const clampedTilt = Math.max(-0.75, Math.min(0.75, this.tiltAngle));
          const slope = -Math.tan(clampedTilt);
          const centerX = w / 2;

          // 1. Spring force & damping per node (snappy fluid following + wave ripples)
          const stiffness = 0.055;
          const damp = 0.095;
          for (let i = 0; i < this.nodeCount; i++) {
            const node = this.nodes[i];
            node.x = (w / (this.nodeCount - 1)) * i;
            const targetFromTilt = currentBaseY + slope * (node.x - centerX);
            node.targetY = Math.max(this.topRimY, Math.min(emptyY + 20, targetFromTilt));

            const delta = node.y - node.targetY;
            const force = -stiffness * delta - damp * node.vy;
            node.vy += force * (dt * 60);
            node.y += (node.targetY - node.y) * 0.28 + node.vy * (dt * 60);
          }

          // 2. 3-pass neighbor wave propagation
          for (let p = 0; p < 3; p++) {
            for (let i = 0; i < this.nodeCount; i++) {
              if (i > 0) {
                const leftDelta = this.spread * (this.nodes[i].y - this.nodes[i - 1].y);
                this.nodes[i - 1].vy += leftDelta;
                this.nodes[i - 1].y += leftDelta * 0.5;
              }
              if (i < this.nodeCount - 1) {
                const rightDelta = this.spread * (this.nodes[i].y - this.nodes[i + 1].y);
                this.nodes[i + 1].vy += rightDelta;
                this.nodes[i + 1].y += rightDelta * 0.5;
              }
            }
          }

          // 3. Bubbles rise
          for (let i = 0; i < this.bubbles.length; i++) {
            const b = this.bubbles[i];
            b.y -= (b.speed * dt) / h;
            b.wobble += b.wobbleSpeed * dt;

            const nodeIdx = Math.max(0, Math.min(this.nodeCount - 1, Math.floor(b.x * (this.nodeCount - 1))));
            const surfaceAtB = this.nodes[nodeIdx] ? this.nodes[nodeIdx].y : currentBaseY;

            if (b.y * h < surfaceAtB + 8 || b.y * h > emptyY) {
              b.y = 0.88 + Math.random() * 0.08;
              b.x = 0.12 + Math.random() * 0.76;
            }
          }
        }

        public draw() {
          const ctx = this.ctx;
          const w = window.innerWidth;
          const h = window.innerHeight;
          const bottomY = h - 20;
          const emptyY = bottomY - this.glassBottomPad;

          ctx.clearRect(0, 0, w, h);

          // 1. Ambient Background Glow
          const backGrad = ctx.createRadialGradient(
            w * 0.5, h * 0.45, 40,
            w * 0.5, h * 0.5, Math.max(w, h) * 0.75
          );
          backGrad.addColorStop(0, '#13240b');
          backGrad.addColorStop(0.6, '#0a1406');
          backGrad.addColorStop(1, '#040903');
          ctx.fillStyle = backGrad;
          ctx.fillRect(0, 0, w, h);

          // 2. Glass Clipping Mask (Tapered Tumbler: 88% top, 62% bottom)
          ctx.save();
          ctx.beginPath();
          ctx.moveTo(this.glassTx1, this.topRimY);
          ctx.lineTo(this.glassTx2, this.topRimY);
          ctx.lineTo(this.glassBx2, bottomY);
          ctx.lineTo(this.glassBx1, bottomY);
          ctx.closePath();
          ctx.clip();

          // Inside Glass Dark Backing
          ctx.fillStyle = 'rgba(7, 16, 5, 0.9)';
          ctx.fillRect(0, 0, w, h);

          // 3. Liquid Body
          if (this.juiceLevel > 0.02 && this.nodes.length >= 2) {
            ctx.save();
            ctx.beginPath();
            ctx.moveTo(0, h);
            ctx.lineTo(w, h);
            ctx.lineTo(w, this.nodes[this.nodeCount - 1].y);

            // Smooth quadratic curve along surface
            for (let i = this.nodeCount - 1; i > 0; i--) {
              const p0 = this.nodes[i];
              const p1 = this.nodes[i - 1];
              const mx = (p0.x + p1.x) / 2;
              const my = (p0.y + p1.y) / 2;
              ctx.quadraticCurveTo(p0.x, p0.y, mx, my);
            }
            ctx.lineTo(0, this.nodes[0].y);
            ctx.closePath();

            // Sugarcane Flavor Gradient
            const meanY = (this.nodes[0].y + this.nodes[this.nodeCount - 1].y) / 2;
            const juiceGrad = ctx.createLinearGradient(w / 2, meanY, w / 2, bottomY);

            if (selectedFlavor === 'kesar') {
              juiceGrad.addColorStop(0, '#FFE082');
              juiceGrad.addColorStop(0.25, '#FFB300');
              juiceGrad.addColorStop(0.65, '#E65100');
              juiceGrad.addColorStop(0.85, '#9C2706');
              juiceGrad.addColorStop(1, '#4E1103');
            } else if (selectedFlavor === 'nimbu') {
              juiceGrad.addColorStop(0, '#F3FF96');
              juiceGrad.addColorStop(0.25, '#D4F138');
              juiceGrad.addColorStop(0.65, '#A3C914');
              juiceGrad.addColorStop(0.85, '#5C7C0B');
              juiceGrad.addColorStop(1, '#2E3F05');
            } else {
              // Classic Saada Ganna
              juiceGrad.addColorStop(0, '#E4F78F');
              juiceGrad.addColorStop(0.25, '#C5E038');
              juiceGrad.addColorStop(0.65, '#99B816');
              juiceGrad.addColorStop(0.85, '#556E0B');
              juiceGrad.addColorStop(1, '#2E3D06');
            }

            ctx.fillStyle = juiceGrad;
            ctx.fill();

            // 4. Rising Carbonation Bubbles
            ctx.fillStyle = 'rgba(255, 255, 230, 0.7)';
            for (let i = 0; i < this.bubbles.length; i++) {
              const b = this.bubbles[i];
              const absX = b.x * w + Math.sin(b.wobble) * 6;
              const absY = b.y * h;
              const nodeIdx = Math.max(0, Math.min(this.nodeCount - 1, Math.floor(b.x * (this.nodeCount - 1))));
              const surfaceY = this.nodes[nodeIdx] ? this.nodes[nodeIdx].y : meanY;

              if (absY > surfaceY + 6 && absY < emptyY) {
                ctx.beginPath();
                ctx.arc(absX, absY, b.radius, 0, Math.PI * 2);
                ctx.fill();
              }
            }

            // 5. Floating Garnishes (Ice, Mint, Saffron)
            // Ice cube 1
            const iceCol = this.nodes[Math.floor(this.nodeCount * 0.35)];
            if (iceCol && this.juiceLevel > 0.05) {
              ctx.save();
              ctx.translate(iceCol.x, iceCol.y + 4);
              ctx.rotate(this.tiltAngle * 0.7);
              ctx.fillStyle = 'rgba(230, 245, 255, 0.65)';
              ctx.strokeStyle = 'rgba(255, 255, 255, 0.9)';
              ctx.lineWidth = 1.8;
              ctx.fillRect(-14, -14, 28, 28);
              ctx.strokeRect(-14, -14, 28, 28);
              ctx.restore();
            }
            // Ice cube 2
            const iceCol2 = this.nodes[Math.floor(this.nodeCount * 0.68)];
            if (iceCol2 && this.juiceLevel > 0.05) {
              ctx.save();
              ctx.translate(iceCol2.x, iceCol2.y + 2);
              ctx.rotate(-this.tiltAngle * 0.6 + 0.4);
              ctx.fillStyle = 'rgba(230, 245, 255, 0.6)';
              ctx.strokeStyle = 'rgba(255, 255, 255, 0.85)';
              ctx.lineWidth = 1.6;
              ctx.fillRect(-12, -12, 24, 24);
              ctx.strokeRect(-12, -12, 24, 24);
              ctx.restore();
            }

            // Mint garnish for Nimbu
            if (selectedFlavor === 'nimbu') {
              const mintCol = this.nodes[Math.floor(this.nodeCount * 0.52)];
              if (mintCol && this.juiceLevel > 0.05) {
                ctx.save();
                ctx.translate(mintCol.x, mintCol.y + 3);
                ctx.rotate(this.tiltAngle + 0.2);
                ctx.fillStyle = '#48BB78';
                ctx.strokeStyle = '#22543D';
                ctx.lineWidth = 1.2;
                ctx.beginPath();
                ctx.ellipse(0, 0, 13, 7, 0.2, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();
                ctx.restore();
              }
            }

            // Saffron strand for Kesar
            if (selectedFlavor === 'kesar') {
              const kesarCol = this.nodes[Math.floor(this.nodeCount * 0.48)];
              if (kesarCol && this.juiceLevel > 0.05) {
                ctx.save();
                ctx.translate(kesarCol.x, kesarCol.y + 2);
                ctx.strokeStyle = '#DC2626';
                ctx.lineWidth = 2.4;
                ctx.beginPath();
                ctx.moveTo(-14, 0);
                ctx.quadraticCurveTo(0, -6, 14, 2);
                ctx.stroke();
                ctx.restore();
              }
            }

            // 6. Creamy Sugarcane Froth (Foam Ribbon / Jhag)
            const frothH = 13;
            ctx.beginPath();
            ctx.moveTo(0, this.nodes[0].y);
            for (let i = 1; i < this.nodeCount; i++) {
              const p0 = this.nodes[i - 1];
              const p1 = this.nodes[i];
              const mx = (p0.x + p1.x) / 2;
              const my = (p0.y + p1.y) / 2;
              ctx.quadraticCurveTo(p0.x, p0.y, mx, my);
            }
            ctx.lineTo(w, this.nodes[this.nodeCount - 1].y + frothH);

            for (let i = this.nodeCount - 1; i > 0; i--) {
              const p0 = this.nodes[i];
              const p1 = this.nodes[i - 1];
              const mx = (p0.x + p1.x) / 2;
              const my = ((p0.y + p1.y) / 2) + frothH;
              ctx.quadraticCurveTo(p0.x, p0.y + frothH, mx, my);
            }
            ctx.lineTo(0, this.nodes[0].y + frothH);
            ctx.closePath();

            const frothGrad = ctx.createLinearGradient(0, meanY - 4, 0, meanY + frothH + 4);
            frothGrad.addColorStop(0, '#FCFFE7');
            frothGrad.addColorStop(0.35, '#EBF9A4');
            frothGrad.addColorStop(0.75, '#D5EE66');
            frothGrad.addColorStop(1, 'rgba(180, 220, 50, 0)');
            ctx.fillStyle = frothGrad;
            ctx.fill();

            // Froth specks along surface
            ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
            for (let i = 0; i < this.frothSpecks.length; i++) {
              const s = this.frothSpecks[i];
              const nodeIdx = Math.max(0, Math.min(this.nodeCount - 1, Math.floor(s.nodePct * (this.nodeCount - 1))));
              const baseNode = this.nodes[nodeIdx];
              if (baseNode) {
                const sx = baseNode.x + (s.nodePct * 14 - 7);
                const sy = baseNode.y + s.offsetY;
                ctx.beginPath();
                ctx.arc(sx, sy, s.radius, 0, Math.PI * 2);
                ctx.fill();
              }
            }

            ctx.restore();
          }

          // 7. Fluted Mumbai Cutting Chai Glass Tumbler Facets & Overlay
          this.drawGlassTumbler(ctx, w, h);

          ctx.restore(); // Restore clipping
        }

        private drawGlassTumbler(ctx: CanvasRenderingContext2D, w: number, h: number) {
          const bottomY = h - 20;

          // (a) Thick Pressed-Glass Base at Bottom
          const baseH = this.glassBottomPad + 18;
          const baseGrad = ctx.createLinearGradient(0, bottomY - baseH, 0, bottomY);
          baseGrad.addColorStop(0, 'rgba(255, 255, 255, 0.08)');
          baseGrad.addColorStop(0.3, 'rgba(200, 235, 150, 0.15)');
          baseGrad.addColorStop(0.8, 'rgba(40, 70, 20, 0.5)');
          baseGrad.addColorStop(1, 'rgba(10, 20, 5, 0.85)');
          ctx.fillStyle = baseGrad;
          ctx.fillRect(0, bottomY - baseH, w, baseH);

          // Glass base rim line
          ctx.beginPath();
          ctx.moveTo(0, bottomY - baseH);
          ctx.lineTo(w, bottomY - baseH);
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.22)';
          ctx.lineWidth = 2.0;
          ctx.stroke();

          // (b) 8 Authentic Fluted Facet Ribs
          const facetCount = 8;
          for (let i = 1; i < facetCount; i++) {
            const tX = this.glassTx1 + ((this.glassTx2 - this.glassTx1) / facetCount) * i;
            const bX = this.glassBx1 + ((this.glassBx2 - this.glassBx1) / facetCount) * i;

            ctx.beginPath();
            ctx.moveTo(tX, this.topRimY);
            ctx.lineTo(bX, bottomY - baseH);
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.06)';
            ctx.lineWidth = 3;
            ctx.stroke();

            ctx.beginPath();
            ctx.moveTo(tX + 3, this.topRimY);
            ctx.lineTo(bX + 3, bottomY - baseH);
            ctx.strokeStyle = 'rgba(0, 0, 0, 0.18)';
            ctx.lineWidth = 3;
            ctx.stroke();
          }

          // (c) Left Wall Specular Gloss Strip
          ctx.beginPath();
          ctx.moveTo(this.glassTx1, this.topRimY);
          ctx.lineTo(this.glassTx1 + 24, this.topRimY);
          ctx.lineTo(this.glassBx1 + 24, bottomY);
          ctx.lineTo(this.glassBx1, bottomY);
          ctx.closePath();
          const leftGloss = ctx.createLinearGradient(this.glassBx1, 0, this.glassBx1 + 24, 0);
          leftGloss.addColorStop(0, 'rgba(255, 255, 255, 0.45)');
          leftGloss.addColorStop(0.4, 'rgba(255, 255, 255, 0.15)');
          leftGloss.addColorStop(1, 'rgba(255, 255, 255, 0)');
          ctx.fillStyle = leftGloss;
          ctx.fill();

          // (d) Right Wall Specular Gloss Strip
          ctx.beginPath();
          ctx.moveTo(this.glassTx2 - 24, this.topRimY);
          ctx.lineTo(this.glassTx2, this.topRimY);
          ctx.lineTo(this.glassBx2, bottomY);
          ctx.lineTo(this.glassBx2 - 24, bottomY);
          ctx.closePath();
          const rightGloss = ctx.createLinearGradient(this.glassBx2 - 24, 0, this.glassBx2, 0);
          rightGloss.addColorStop(0, 'rgba(255, 255, 255, 0)');
          rightGloss.addColorStop(0.6, 'rgba(255, 255, 255, 0.12)');
          rightGloss.addColorStop(1, 'rgba(255, 255, 255, 0.35)');
          ctx.fillStyle = rightGloss;
          ctx.fill();

          // (e) Top Glass Oval Lip Rim
          const rimW = this.glassTx2 - this.glassTx1;
          ctx.beginPath();
          ctx.ellipse(this.glassTx1 + rimW / 2, this.topRimY, rimW / 2, 9, 0, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.45)';
          ctx.lineWidth = 2.2;
          ctx.stroke();

          // (f) Subtle dotted fill line
          ctx.beginPath();
          ctx.setLineDash([4, 6]);
          ctx.ellipse(this.glassTx1 + rimW / 2, this.topRimY + 30, (rimW * 0.96) / 2, 8, 0, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.18)';
          ctx.lineWidth = 1.5;
          ctx.stroke();
          ctx.setLineDash([]);
        }
      }

      // Initialize Liquid Renderer
      const canvas = document.getElementById('liquid-physics-canvas') as HTMLCanvasElement;
      let liquidRenderer: LiquidRenderer | null = null;
      if (canvas) {
        liquidRenderer = new LiquidRenderer(canvas);
        window.addEventListener('resize', () => liquidRenderer?.resize());
        window.addEventListener('orientationchange', () => {
          setTimeout(() => liquidRenderer?.resize(), 150);
        });
      }



      // Main 60fps Physics & Render Loop
      let lastTime = performance.now();
      let animFrameId: number | null = null;
      let lastGulpTime = 0;

      function renderLoop(now: number) {
        const dt = Math.min((now - lastTime) / 1000, 0.05);
        lastTime = now;

        // =========================================================
        // 1. GYROSCOPE ORIENTATION CONTROLS FLUID SLOSHING & WAVES
        // Normal movement, slight tilt (10°, 20°, 30°, 45°), rotating, shaking
        // continuously drives realistic fluid surface physics WITHOUT consuming juice.
        // =========================================================
        const rollRad = (sensorManager.calculatedTiltX * Math.PI) / 180;

        if (liquidRenderer) {
          liquidRenderer.update(rollRad, dt);
          liquidRenderer.draw();
        }

        // =========================================================
        // 2. STRICT UPSIDE-DOWN ORIENTATION THRESHOLD CONTROLS DRINKING
        // • Normal movement, tilt < 140° => NO consumption (juice amount unchanged)
        // • Upside-down tilt >= 140° => START continuous consumption
        // • Tilted back below 125° => STOP consumption immediately!
        // =========================================================
        if (sensorManager.isDrinking && liquidRenderer && !isFinished && liquidRenderer.targetJuiceLevel > 0) {
          // Smooth continuous decrease while in upside-down position
          // DRAIN_RATE = 0.18 (takes ~5.5s of continuous upside-down holding to empty full glass)
          const DRAIN_RATE = 0.18;
          liquidRenderer.targetJuiceLevel = Math.max(0, liquidRenderer.targetJuiceLevel - DRAIN_RATE * dt);

          // Periodic gulp sound every 950ms while continuously drinking
          if (now - lastGulpTime >= 950) {
            lastGulpTime = now;
            soundEngine.playGulp();
            if (typeof navigator !== 'undefined' && 'vibrate' in navigator) {
              try { navigator.vibrate(45); } catch {}
            }
          }

          // Spout overflow visual at top rim while pouring into mouth
          pourStreamLeft?.classList.remove('opacity-0');

          // Live percentage display
          const remainingPct = Math.round(liquidRenderer.targetJuiceLevel * 100);
          if (sipCountBadge) sipCountBadge.textContent = `${remainingPct}%`;
          if (sipCardTitle) sipCardTitle.textContent = 'Gatak Gatak... 🥤 Piyo!';
          if (sipCardDesc) {
            sipCardDesc.textContent = 'Gatak gatak... peete raho! Lower phone to pause.';
          }

          if (liquidRenderer.targetJuiceLevel <= 0.005) {
            liquidRenderer.targetJuiceLevel = 0;
            liquidRenderer.juiceLevel = 0;
            isFinished = true;
            soundEngine.playCheers();
            if (sipCardTitle) sipCardTitle.textContent = 'GLASS KHATAM! 🎉';
            if (sipCardDesc) sipCardDesc.textContent = 'Sukoon: 100% Guaranteed ☀️ Taaza Ganna Baar!';
            if (sipCountBadge) sipCountBadge.textContent = '0%';
            sipTapCard?.classList.add('hidden');
            finishReplayBtn?.classList.remove('hidden');
            finishReplayBtn?.classList.add('flex');
            pourStreamLeft?.classList.add('opacity-0');
            showToast('🎉 Glass Khatam! Asli desi sukoon mil gaya!');
          }
        } else if (!isFinished && liquidRenderer) {
          // Normal movement / below threshold: Consumption is STOPPED immediately!
          pourStreamLeft?.classList.add('opacity-0');
          pourStreamRight?.classList.add('opacity-0');

          if (sipCardTitle) sipCardTitle.textContent = 'Chuski Lo — Asli Sukoon';
          if (sipCardDesc) {
            sipCardDesc.textContent = 'Hold phone like a real glass & tilt upside-down to drink!';
          }
        }

        // Visual overflow splash on extreme left or right edge tilt
        if (liquidRenderer && liquidRenderer.juiceLevel > 0.05 && !isFinished) {
          const leftNode = liquidRenderer.nodes[0];
          const rightNode = liquidRenderer.nodes[liquidRenderer.nodeCount - 1];
          if (leftNode && leftNode.y <= liquidRenderer.topRimY + 8) {
            pourStreamLeft?.classList.remove('opacity-0');
          }
          if (rightNode && rightNode.y <= liquidRenderer.topRimY + 8) {
            pourStreamRight?.classList.remove('opacity-0');
          }
        }

        animFrameId = requestAnimationFrame(renderLoop);
      }

      // Manual tap sip (for tap users or fallback)
      function takeManualSip() {
        if (isFinished || !liquidRenderer) return;
        soundEngine.playGulp();
        liquidRenderer.targetJuiceLevel = Math.max(0, liquidRenderer.targetJuiceLevel - 0.25);
        liquidRenderer.splash(0.5, 12.0);
        const remainingPct = Math.round(liquidRenderer.targetJuiceLevel * 100);
        if (sipCountBadge) sipCountBadge.textContent = `${remainingPct}%`;
        showToast(`🥤 Tap Sip! Bacha: ${remainingPct}%`);

        if (liquidRenderer.targetJuiceLevel <= 0.005) {
          liquidRenderer.targetJuiceLevel = 0;
          liquidRenderer.juiceLevel = 0;
          isFinished = true;
          soundEngine.playCheers();
          if (sipCardTitle) sipCardTitle.textContent = 'GLASS KHATAM! 🎉';
          if (sipCardDesc) sipCardDesc.textContent = 'Sukoon: 100% Guaranteed ☀️ Taaza Ganna Baar!';
          if (sipCountBadge) sipCountBadge.textContent = '0%';
          sipTapCard?.classList.add('hidden');
          finishReplayBtn?.classList.remove('hidden');
          finishReplayBtn?.classList.add('flex');
        }
      }

      function resetGlass() {
        isFinished = false;
        sensorManager.calibrate();
        if (sipCountBadge) sipCountBadge.textContent = '100%';
        if (sipCardTitle) sipCardTitle.textContent = 'Chuski Lo — Asli Sukoon';
        if (sipCardDesc) sipCardDesc.textContent = 'Hold the phone like a real glass and tilt upside-down to drink!';
        sipTapCard?.classList.remove('hidden');
        finishReplayBtn?.classList.add('hidden');
        finishReplayBtn?.classList.remove('flex');
        if (liquidRenderer) {
          liquidRenderer.targetJuiceLevel = 1.0;
          liquidRenderer.juiceLevel = 1.0;
          liquidRenderer.initNodes();
        }
      }

      // Tap on bottom card to sip
      sipTapCard?.addEventListener('click', () => {
        takeManualSip();
      });

      resetBtn?.addEventListener('click', () => {
        soundEngine.playClick();
        resetGlass();
      });

      finishReplayBtn?.addEventListener('click', () => {
        soundEngine.playClick();
        resetGlass();
      });

      // Transition from Menu to Full-Screen Drinking View
      openGlassBtn?.addEventListener('click', () => {
        sensorManager.requestAccess();
        sensorManager.calibrate();
        soundEngine.playClick();

        viewMenu?.classList.add('hidden');
        viewDrinking?.classList.remove('hidden');
        viewDrinking?.classList.add('block');

        if (sipFlavorIcon) {
          sipFlavorIcon.textContent = selectedFlavor === 'kesar' ? '👑' : selectedFlavor === 'nimbu' ? '🍋' : '🌾';
        }

        resetGlass();
        if (liquidRenderer) {
          liquidRenderer.resize();
        }

        if (!animFrameId) {
          lastTime = performance.now();
          animFrameId = requestAnimationFrame(renderLoop);
        }
      });

      backToMenuBtn?.addEventListener('click', () => {
        soundEngine.playClick();
        viewDrinking?.classList.add('hidden');
        viewDrinking?.classList.remove('block');
        viewMenu?.classList.remove('hidden');
      });

      // Tap on glass directly to sip (Zero fake roll simulation)
      let dragStartX = 0;
      let dragStartY = 0;
      let totalDragDist = 0;

      window.addEventListener('pointerdown', (e) => {
        // Any first tap/touch registers user-gesture and triggers sensor permission & listeners
        sensorManager.requestAccess();
        if (viewDrinking?.classList.contains('hidden')) return;
        const target = e.target as HTMLElement;
        if (target.closest('button') || target.closest('#sip-tap-card') || target.closest('#jukebox-pill')) return;
        dragStartX = e.clientX;
        dragStartY = e.clientY;
        totalDragDist = 0;
      });

      window.addEventListener('pointermove', (e) => {
        const deltaX = e.clientX - dragStartX;
        const deltaY = e.clientY - dragStartY;
        totalDragDist = Math.max(totalDragDist, Math.hypot(deltaX, deltaY));
      });

      window.addEventListener('pointerup', () => {
        if (viewDrinking?.classList.contains('hidden')) return;
        if (totalDragDist < 8 && !isFinished) {
          takeManualSip();
        }
      });

      // Initialize Menu View
      updateMenuUI();
    </script>
  </body>
</html>
